# Copy this file to .env and adjust the values.
# OpenMeter backend (used by the Vite proxy for /api requests).
# Non-VITE_ prefixed, so it is never exposed to the browser bundle.
API_PROXY_TARGET=http://localhost:48888

# Frontend API base URL. Leave as /api to go through the Vite dev proxy.
# Set to an absolute URL (e.g. http://192.168.15.21:48888/api) to talk to the
# backend directly without a proxy (also used in production builds).
VITE_API_BASE_URL=/api

# Default "API Proxy Target" shown on the Settings screen. This is the full
# base URL the browser connects to (dev proxy target + /api suffix), and can
# be overridden per-browser from Settings.
VITE_API_PROXY_TARGET=http://localhost:48888/api
